# Build-time configuration (Astro SSG — values are read during `astro build`).

# Gobbly API used to fetch the public restaurant directory.
# Default (unset): https://api.gobbly.app — correct for production builds.
# Only set this for local development against a local API.
# API_URL=http://localhost:3001

# Base domain for tenant subdomain links ({slug}.TENANT_DOMAIN).
# TENANT_DOMAIN=gobbly.app

# Escape hatch: allow a production build whose restaurant directory is empty
# (otherwise the build fails to avoid silently shipping an empty section).
# ALLOW_EMPTY_DIRECTORY=true
