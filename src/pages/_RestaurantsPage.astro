---
import Layout from '@layouts/Layout.astro'
import Breadcrumbs from '@components/ui/Breadcrumbs.astro'
import Navbar from '@components/layout/Navbar.astro'
import Footer from '@components/layout/Footer.astro'
import CtaSection from '@components/sections/CtaSection.astro'
import RestaurantsDirectory from '@components/sections/RestaurantsDirectory.astro'
import '@styles/global.css'
import type { Locale } from '@i18n/types'
import { getTranslations } from '@i18n/utils'

interface Props { locale: Locale }
const { locale } = Astro.props
const t = getTranslations(locale)
---

<Layout
  locale={locale}
  title={`${t.restaurants.title} — Gobbly`}
  description={t.restaurants.metaDescription}
  path="/restaurants/"
>
  <Navbar locale={locale} />
  <main class="pt-28 md:pt-36">
    <div class="max-w-6xl mx-auto px-6 pt-4">
      <Breadcrumbs locale={locale} items={[
        { label: t.nav.home, href: `/${locale}/` },
        { label: t.nav.restaurants },
      ]} />
    </div>

    <RestaurantsDirectory locale={locale} />
    <CtaSection locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
